# Optional reference. Startup creates/upgrades .env automatically and backs up old values.
# Versioned defaults are appended once; subsequent edits to the final block are preserved.
# Shell environment overrides .env. Values are shell syntax.
HOST=0.0.0.0
PORT=8000
CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
# Select the resident adapter: 8 = Ref2VA 8-step v1.0 768p; 4 = 4-step v0.1.
# Changes need ./deploy.sh restart; a missing selected LoRA downloads automatically.
REF2VA_NFE=8
# HF_TOKEN=hf_...
# HF_ENDPOINT=https://huggingface.co
# DATA_DIR=/data/navid4nfe
# CHECKPOINT_DIR=/data/models/navid4nfe
# Reuse an existing Diffusers-layout checkpoint instead of downloading:
# MODEL_DIR=/data/models/MiniMax-H3
# Optional custom location for the selected official adapter (SHA256 checked):
# ADAPTER_PATH=/data/models/minimax_h3_ref2v_turbo_8step_v1.0_768p_bf16.safetensors
# Model load + first inference can take a long time on the first launch.
READY_TIMEOUT=7200
TASK_TIMEOUT=1800
MAX_QUEUE=32
MAX_UPLOAD_MB=64
# VAE compilation is optional; default off to reduce startup time on H200.
VAE_COMPILE=0

# Request defaults; an explicit API value overrides the corresponding default.
SOL_ATTN_ENABLED=1
SOL_ATTN_TAU=1.5
SOL_ATTN_DENSE_STEPS=1
CACHE_DIT_ENABLED=1
CACHE_DIT_WARMUP=1
CACHE_DIT_RDT=0.08
CACHE_DIT_MAX_CONTINUOUS=1
# Enable DiT residual cache and DiT torch.compile by default; VAE stays eager.
# Sol still uses its required Triton JIT kernels and their disk cache.
DIT_COMPILE=1
# auto chooses 1/2/4/8 concurrent rank loads from available host/container RAM.
# Explicit 1 restores serial loading. Concurrent loads still keep one copy per GPU.
MODEL_LOAD_PARALLELISM=auto
# Admission limits, not a guarantee that every admitted shape fits GPU memory.
MAX_OUTPUT_PIXELS=2088960
MAX_PACKED_TOKENS=262144
